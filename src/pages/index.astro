---
import Base from '../layouts/Base.astro';
import games from '../data/games.json';
import screenshots from '../data/screenshots.json';
import {genreDetails, slugify} from '../data/genres.mjs';
const playable = games.filter(game => game.play);
const sourceOnly = games.filter(game => !game.play);
const genres = Object.keys(genreDetails);
const images: Record<string, {file: string}> = screenshots;
const picks: Record<string, string> = {
  'Action':'kata-grand-theft-auto-astra-6-ultra', 'Adventure':'kata-inspired-by-the-legend-of-zelda-breath-of-the-wild-codex-dot',
  'Arcade':'kata-inspired-by-full-tilt-pinball-codex-dot', 'Board & card':'kata-inspired-by-uno-codex-dot',
  'Party':'kata-inspired-by-pico-park-codex-dot', 'Platformer':'kata-inspired-by-braid-codex-dot',
  'Puzzle':'kata-inspired-by-baba-is-you-codex-dot', 'Racing & sports':'kata-inspired-by-ssx-3-codex-dot',
  'Rhythm':'', 'Role-playing':'kata-diablo-clone-astra-6-ultra',
  'Simulation & creative':'kata-inspired-by-minecraft-codex-dot', 'Strategy':'kata-inspired-by-starcraft-brood-war-codex-dot',
};
---
<Base title="The Kata Arcade" description="Browse intrepion’s browser game experiments by genre.">
<section class="hero wrap"><div class="hero-copy"><p class="eyebrow"><span class="dot"></span> AN INDEPENDENT PLAYGROUND</p><h1>Find your<br /><em>kind of play.</em></h1><p>Little worlds, clever puzzles, and everything in between. Pick a genre and see where curiosity takes you.</p><a class="button button-light" href="#genres">Explore the genres <span aria-hidden="true">↓</span></a><div class="hero-meta"><span><b>{playable.length}</b> playable experiments</span><span><b>{genres.length}</b> ways to play</span></div></div><div class="hero-visual" aria-hidden="true"><div class="hero-grid"></div><span class="hero-stamp">THE KATA ARCADE / EST. WITH CURIOSITY</span><div class="hero-shape shape-one">✳</div><div class="hero-shape shape-two">↗</div><div class="hero-shape shape-three">◈</div><span class="hero-caption">CHOOSE YOUR OWN<br />LITTLE ADVENTURE <b>↗</b></span><span class="hero-index">001 — ∞</span></div></section>
<section class="genre-section wrap" id="genres"><div class="section-intro"><div><p class="eyebrow">THE COLLECTION / EXPLORE BY GENRE</p><h2>What are you<br /><em>in the mood for?</em></h2></div><p>From quick diversions to worlds worth getting lost in. Games can live in more than one genre, so follow whatever catches your eye.</p></div>
<div class="genre-grid">{genres.map((genre, index) => { const count = playable.filter(g => g.genres.includes(genre)).length; const pick = picks[genre]; return <a class={`genre-card genre-tone-${index % 6}`} href={`/genres/${slugify(genre)}/`}><div class="genre-art" aria-hidden="true">{pick && images[pick] ? <img src={images[pick].file} alt="" loading="lazy" width="720" height="450" /> : <div class="genre-pattern"><span>♫</span><i>♪</i></div>}<span class="genre-number">{genreDetails[genre][1]} / 12</span><span class="genre-arrow">↗</span></div><div class="genre-card-copy"><div><p>{genreDetails[genre][0]}</p><h3>{genre}</h3></div><span class="genre-count">{count} games</span></div></a>})}</div></section>
<section class="workshop wrap" aria-labelledby="workshop-title"><details><summary><span><span class="eyebrow">ON THE WORKBENCH</span><span id="workshop-title" class="workshop-title">More experiments, still taking shape <small>{sourceOnly.length} repositories</small></span></span><span aria-hidden="true">+</span></summary><p>Source code to explore. These projects have no current GitHub Pages deployment and aren’t listed as playable games.</p><ul class="source-list">{sourceOnly.map(game => <li><a href={game.repo}>{game.title} ↗</a><span>{game.edition} · Inspired by {game.inspiration}</span></li>)}</ul></details></section>
<section class="about wrap" id="about"><p class="eyebrow">PRACTICE, WITH A PLAY BUTTON</p><h2>A kata is a small exercise.<br /><em>This is where they come to play.</em></h2><p>I’m Oliver, also known as intrepion. This arcade brings my game experiments together: different tools, different approaches, and plenty of curiosity. Choose an inspiration you love, or meet something new.</p><a href="https://github.com/intrepion/intrepion.github.io">Explore the gallery source ↗</a></section>
</Base>
