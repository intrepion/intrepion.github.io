---
import Base from '../../layouts/Base.astro';
import GameCard from '../../components/GameCard.astro';
import games from '../../data/games.json';
import {groupInspirations} from '../../data/inspirations.mjs';
import {slugify} from '../../data/genres.mjs';
export function getStaticPaths() { return groupInspirations(games).map(group => ({params: {inspiration: group.slug}, props: {group}})); }
const {group} = Astro.props;
const versions = [...group.games].sort((a,b) => a.title.localeCompare(b.title));
const genres = [...new Set(versions.flatMap(game => game.genres))] as string[];
---
<Base title={`Inspired by ${group.name}`} description={`Explore games inspired by ${group.name}.`}><section class="genre-hero wrap"><a class="back-link" href="/#genres">← All genres</a><div class="genre-hero-row"><div><p class="eyebrow">INSPIRED BY</p><h1>{group.name}<span>.</span></h1><p>{versions.length} {versions.length === 1 ? 'experiment' : 'experiments'}, each with its own take.</p><div class="genre-shortcuts detail-tags">{genres.map(g => <a href={`/genres/${slugify(g)}/`}>{g} ↗</a>)}</div></div><div class="genre-hero-symbol" aria-hidden="true">✳</div></div></section><section class="listing wrap"><div class="listing-heading"><div><p class="eyebrow">ONE IDEA / MANY DIRECTIONS</p><h2>Explore the experiments</h2></div></div><div class="game-grid">{versions.map(game => <GameCard game={game} />)}</div></section><section class="more-genres wrap"><div><p class="eyebrow">KEEP EXPLORING</p><h2>Find another inspiration.</h2></div><a class="button button-dark" href="/#genres">Browse genres ↗</a></section></Base>
