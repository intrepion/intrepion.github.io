---
import Base from '../../layouts/Base.astro';
import GameCard from '../../components/GameCard.astro';
import games from '../../data/games.json';
import {genreDetails, slugify} from '../../data/genres.mjs';
export function getStaticPaths() { return Object.keys(genreDetails).map(genre => ({params: {genre: slugify(genre)}, props: {genre}})); }
const {genre} = Astro.props;
const playable = games.filter(game => game.play && game.genres.includes(genre)).sort((a,b) => a.title.localeCompare(b.title));
const genres = Object.keys(genreDetails);
---
<Base title={`${genre} games`} description={`Explore ${genre.toLowerCase()} games in the Kata Arcade.`}>
<section class="genre-hero wrap"><a class="back-link" href="/#genres">← All genres</a><div class="genre-hero-row"><div><p class="eyebrow">THE COLLECTION / {genreDetails[genre][1]} OF 12</p><h1>{genre}<span>.</span></h1><p>{genreDetails[genre][0]} Explore {playable.length} browser {playable.length === 1 ? 'experiment' : 'experiments'}.</p></div><div class="genre-hero-symbol" aria-hidden="true">✳</div></div></section>
<section class="listing wrap" aria-labelledby="listing-title"><div class="listing-heading"><div><p class="eyebrow">PICK UP & PLAY</p><h2 id="listing-title">Explore {genre.toLowerCase()}</h2></div><button class="random-button" type="button" id="random" hidden>Surprise me ↗</button></div><form class="controls" id="controls" role="search" hidden><div class="search-field"><span aria-hidden="true">⌕</span><label class="sr-only" for="search">Search this genre</label><input id="search" type="search" placeholder="Search games, inspirations, editions…" autocomplete="off" /><button type="button" id="clear" aria-label="Clear search" hidden>×</button></div><div class="sort-field"><label for="sort">Sort by</label><select id="sort"><option value="title">Game title: A–Z</option><option value="inspiration">Inspiration: A–Z</option></select></div></form><p class="results" id="results" role="status" aria-live="polite" aria-atomic="true">Showing all {playable.length} games</p><div class="game-grid" id="games">{playable.map(game => <GameCard game={game} />)}</div><div class="empty-state" id="empty" hidden><h2>No games found.</h2><p>Try another search to explore this genre.</p><button type="button" class="button button-dark" id="reset">Clear search</button></div><noscript><p class="noscript">All games are shown. Enable JavaScript to search or sort this genre.</p></noscript></section>
<section class="more-genres wrap"><div><p class="eyebrow">KEEP EXPLORING</p><h2>Another kind of play?</h2></div><a class="button button-dark" href="/#genres">See all genres ↗</a><div class="genre-shortcuts" aria-label="Other genres">{genres.filter(g => g !== genre).map(g => <a href={`/genres/${slugify(g)}/`}>{g} ↗</a>)}</div></section>
<script>
 const cards = Array.from(document.querySelectorAll<HTMLElement>('.game-card'));
 const search = document.querySelector<HTMLInputElement>('#search')!;
 const sort = document.querySelector<HTMLSelectElement>('#sort')!;
 const grid = document.querySelector<HTMLElement>('#games')!;
 const results = document.querySelector<HTMLElement>('#results')!;
 const empty = document.querySelector<HTMLElement>('#empty')!;
 const clear = document.querySelector<HTMLButtonElement>('#clear')!;
 function update() { const words = search.value.trim().toLowerCase().split(/\s+/).filter(Boolean); let count = 0; cards.forEach(card => {const match = words.every(word => card.dataset.search!.includes(word)); card.hidden = !match; if(match) count++;}); cards.sort((a,b) => (sort.value === 'inspiration' ? a.dataset.inspiration!.localeCompare(b.dataset.inspiration!) || a.dataset.title!.localeCompare(b.dataset.title!) : a.dataset.title!.localeCompare(b.dataset.title!))).forEach(card => grid.append(card)); results.textContent = `Showing ${count} of ${cards.length} games`; empty.hidden = count !== 0; clear.hidden = !search.value; }
 document.querySelector('#controls')!.addEventListener('submit', event => event.preventDefault()); search.addEventListener('input',update); sort.addEventListener('change',update); clear.addEventListener('click',()=>{search.value=''; update(); search.focus();}); document.querySelector('#reset')!.addEventListener('click',()=>{search.value=''; update(); search.focus();}); document.querySelector<HTMLButtonElement>('#random')!.addEventListener('click', () => {const visible = cards.filter(card => !card.hidden); if (visible.length) window.location.assign(visible[Math.floor(Math.random() * visible.length)].querySelector<HTMLAnchorElement>('.play-link')!.href);}); document.querySelector<HTMLElement>('#controls')!.hidden = false; document.querySelector<HTMLElement>('#random')!.hidden = false;
</script>
</Base>
