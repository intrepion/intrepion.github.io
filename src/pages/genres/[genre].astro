---
import Base from '../../layouts/Base.astro';
import InspirationCard from '../../components/InspirationCard.astro';
import games from '../../data/games.json';
import {genreDetails, slugify} from '../../data/genres.mjs';
import {groupInspirations} from '../../data/inspirations.mjs';
export function getStaticPaths() { return Object.keys(genreDetails).map(genre => ({params: {genre: slugify(genre)}, props: {genre}})); }
const {genre} = Astro.props;
const allGroups = groupInspirations(games);
const groups = allGroups.filter(group => group.games.some((game: {genres:string[]}) => game.genres.includes(genre)));
const genres = Object.keys(genreDetails);
---
<Base title={`${genre} inspirations`} description={`Explore the games that inspired ${genre.toLowerCase()} experiments in the Kata Arcade.`}>
<section class="genre-hero wrap"><a class="back-link" href="/arcade/#genres">← All genres</a><div class="genre-hero-row"><div><p class="eyebrow">THE COLLECTION / {genreDetails[genre][1]} OF 12</p><h1>{genre}<span>.</span></h1><p>{genreDetails[genre][0]} Explore {groups.length} inspirations.</p></div><div class="genre-hero-symbol" aria-hidden="true">✳</div></div></section>
<section class="listing wrap" aria-labelledby="listing-title"><div class="listing-heading"><div><p class="eyebrow">START WITH AN INSPIRATION</p><h2 id="listing-title">Explore {genre.toLowerCase()}</h2></div></div><p class="listing-note">Choose an inspiration to see all the experiments it sparked, including games in other genres.</p><form class="controls" id="controls" role="search" hidden><div class="search-field"><span aria-hidden="true">⌕</span><label class="sr-only" for="search">Search inspirations or games</label><input id="search" type="search" placeholder="Search inspirations, games, editions…" autocomplete="off" /><button id="clear" type="button" aria-label="Clear search" hidden>×</button></div></form><p class="results" id="results" role="status" aria-live="polite">Showing all {groups.length} inspirations</p><div class="genre-grid">{groups.map(group => <InspirationCard group={group} count={group.games.length} />)}</div><div class="empty-state" id="empty" hidden><h2>No inspirations found.</h2><p>Try a different search.</p><button type="button" class="button button-dark" id="reset">Clear search</button></div></section>
<section class="more-genres wrap"><div><p class="eyebrow">KEEP EXPLORING</p><h2>Another kind of play?</h2></div><a class="button button-dark" href="/arcade/#genres">See all genres ↗</a><div class="genre-shortcuts" aria-label="Other genres">{genres.filter(g => g !== genre).map(g => <a href={`/genres/${slugify(g)}/`}>{g} ↗</a>)}</div></section>
<script>const cards = Array.from(document.querySelectorAll<HTMLElement>('.inspiration-card')); const search = document.querySelector<HTMLInputElement>('#search')!; const clear = document.querySelector<HTMLButtonElement>('#clear')!; const empty = document.querySelector<HTMLElement>('#empty')!; const results = document.querySelector<HTMLElement>('#results')!; function update(){const words=search.value.trim().toLowerCase().split(/\s+/).filter(Boolean); let count=0; cards.forEach(card=>{const match=words.every(word=>card.dataset.search!.includes(word)); card.hidden=!match; if(match) count++;}); results.textContent=`Showing ${count} of ${cards.length} inspirations`; clear.hidden=!search.value; empty.hidden=count!==0;} document.querySelector('#controls')!.addEventListener('submit',event=>event.preventDefault()); search.addEventListener('input',update); function reset(){search.value='';update();search.focus();} clear.addEventListener('click',reset); document.querySelector('#reset')!.addEventListener('click',reset); document.querySelector<HTMLElement>('#controls')!.hidden=false;</script></Base>
