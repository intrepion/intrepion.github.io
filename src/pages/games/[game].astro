---
import Base from '../../layouts/Base.astro';
import games from '../../data/games.json';
import primaryData from '../../data/screenshots.json';
import extraData from '../../data/extra-screenshots.json';
import {canonicalInspiration, inspirationSlug} from '../../data/inspirations.mjs';
import {slugify} from '../../data/genres.mjs';
const primary: Record<string,{file:string;source:string;label?:string}> = primaryData;
const extras: Record<string,{file:string;source:string;label?:string}[]> = extraData;
export function getStaticPaths() {return games.filter(game => game.play).map(game => ({params:{game:game.id},props:{game}}));}
const {game} = Astro.props;
const shots = [...(primary[game.id] ? [primary[game.id]] : []), ...(extras[game.id] || [])];
const inspiration = canonicalInspiration(game.inspiration);
---
<Base title={game.title} description={`Play ${game.title}, inspired by ${game.inspiration}.`}><section class="genre-hero wrap"><a class="back-link" href={`/inspirations/${inspirationSlug(inspiration)}/`}>← Inspired by {inspiration}</a><div class="game-detail-head"><div><p class="eyebrow">{game.edition}</p><h1>{game.title}<span>.</span></h1><p>Inspired by {game.inspiration}</p><div class="genre-shortcuts detail-tags">{game.genres.map(g => <a href={`/genres/${slugify(g)}/`}>{g} ↗</a>)}</div></div><div class="detail-actions"><a class="button button-dark" href={game.play}>Play game ↗</a><a href={game.repo}>View source ↗</a></div></div></section><section class="listing wrap"><div class="listing-heading"><div><p class="eyebrow">A CLOSER LOOK</p><h2>Gameplay screenshots</h2></div></div>{shots.length ? <><p class="listing-note">{shots.length} {shots.length === 1 ? 'capture' : 'captures'} from this game’s repository. Screens may differ from the current published version.</p><div class="screenshots-grid">{shots.map((shot,i) => <figure><img src={shot.file} alt={`${game.title}: ${shot.label || `gameplay view ${i+1}`}`} loading="lazy" width="720" height="450" /><figcaption>{shot.label || `View ${i+1}`} · <a href={game.repo}>Game repository ↗</a> · <code>{shot.source}</code></figcaption></figure>)}</div></> : <div class="missing-image"><span aria-hidden="true">✳</span><div><h3>No screenshots yet</h3><p>This game is ready to play; a gameplay capture hasn’t been added to the arcade yet.</p></div></div>}</section><section class="more-genres wrap"><div><p class="eyebrow">KEEP EXPLORING</p><h2>More inspired by {inspiration}.</h2></div><a class="button button-dark" href={`/inspirations/${inspirationSlug(inspiration)}/`}>See the collection ↗</a></section></Base>
