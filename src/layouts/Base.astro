---
import '../styles/global.css';
import themeScript from '../scripts/theme.js?raw';
interface Props { title?: string; description?: string }
const {title = 'The Kata Arcade', description = 'Small experiments. Endless ways to play.'} = Astro.props;
---
<!doctype html><html lang="en"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="description" content={description} /><meta name="color-scheme" content="light dark" /><meta name="theme-color" content="#f6f6ed" media="(prefers-color-scheme: light)" /><meta name="theme-color" content="#14231c" media="(prefers-color-scheme: dark)" /><script is:inline set:html={themeScript} /><link rel="icon" href="/favicon.svg" type="image/svg+xml" /><title>{title} — intrepion</title></head><body>
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header wrap"><a class="brand" href="/" aria-label="The Kata Arcade home"><span class="brand-mark" aria-hidden="true">✳</span><span>intrepion <i>/</i> <strong>the kata arcade</strong></span></a><nav aria-label="Main navigation"><a href="/#genres">Browse genres</a><a href="/#about">About</a><a href="https://github.com/intrepion">GitHub <span aria-hidden="true">↗</span></a><button type="button" id="theme-toggle" class="theme-toggle" aria-label="Dark mode" aria-pressed="false" hidden>◐ <span>Theme</span></button></nav></header>
<main id="main"><slot /></main>
<footer class="site-footer wrap"><a class="footer-brand" href="/">intrepion / the kata arcade</a><p>Made for the joy of figuring it out.</p><a href="#main">Back to top ↑</a><p class="legal">Independent learning projects. Referenced game names belong to their respective owners; no affiliation or endorsement. Some cards show gameplay; other artwork is decorative. Catalog updated November 6, 2026.</p></footer>
</body></html>
